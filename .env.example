# Odysseus — 시크릿 두 개는 반드시 채워야 기동합니다 (각각 `openssl rand -hex 32`).
# 운영(production)에서는 자리표시자·32자 미만 값을 거부하고, 개발(development)에서는 경고만 합니다.
POSTGRES_PASSWORD=odysseus
JWT_SECRET=
INTERNAL_TOKEN=
# Redis ACL 계정 비밀번호 (각각 `openssl rand -hex 32`). 인증 없는 Redis 접근은 없습니다.
REDIS_API_PASSWORD=
REDIS_RUNNER_PASSWORD=

# 최초 기동(빈 DB) 시 만들 관리자. 비밀번호를 비우면 무작위로 만들어 api 로그에 한 번 출력합니다:
#   docker compose logs api | grep bootstrap
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# 로컬 개발 전용 — 고정 비밀번호의 데모 계정 3개를 만듭니다. 운영(production)에서는 기동을 거부합니다.
# ODYSSEUS_ENV=development
# SEED_DEMO_DATA=true
WEB_PORT=3100
API_PORT=8100
RUNNER_CONCURRENCY=2

# LLM env 폴백 (관리자 콘솔 > 설정에서 공급자 등록을 권장)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_EVAL_MODEL=gpt-4o-mini
