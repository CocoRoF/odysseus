# Odysseus 환경 설정
#
# 이 파일 없이도 `docker compose up -d --build` 로 바로 돕니다 — 아래 값들이 기본값이기 때문입니다.
# 다만 기본 시크릿은 이 저장소에 공개되어 있어 **비밀이 아닙니다.**
# 실제 응시자 데이터를 받기 전에 반드시 바꾸세요 (api 가 기동할 때마다 크게 알립니다):
#
#   cp .env.example .env
#   sed -i "s|^JWT_SECRET=.*|JWT_SECRET=$(openssl rand -hex 32)|" .env
#   sed -i "s|^INTERNAL_TOKEN=.*|INTERNAL_TOKEN=$(openssl rand -hex 32)|" .env
#   sed -i "s|^DATA_ENCRYPTION_KEY=.*|DATA_ENCRYPTION_KEY=$(openssl rand -hex 32)|" .env
#   sed -i "s|^REDIS_API_PASSWORD=.*|REDIS_API_PASSWORD=$(openssl rand -hex 32)|" .env
#   sed -i "s|^REDIS_RUNNER_PASSWORD=.*|REDIS_RUNNER_PASSWORD=$(openssl rand -hex 32)|" .env

# 로그인 세션 서명 키. 바꾸면 로그인해 있던 사람들이 모두 다시 로그인합니다.
JWT_SECRET=odysseus-default-jwt-secret-CHANGE-ME-before-production
# api ↔ 러너 사이의 내부 호출 토큰. 외부에 노출되는 값이 아닙니다.
INTERNAL_TOKEN=odysseus-default-internal-token-CHANGE-ME-before-production
# DB 안의 AI 공급자 키·관리자 설정을 AES-GCM 으로 감싸는 키.
# ※ 한 번 정하면 DB 백업과 한 세트로 보관하세요. 바꾸면 그 전에 저장한 공급자 키·토큰을 읽지 못해
#    관리 콘솔에서 다시 입력해야 합니다 (응시 기록·제출물은 암호화 대상이 아니라 영향 없음).
DATA_ENCRYPTION_KEY=odysseus-default-data-encryption-key-CHANGE-ME-before-production
# Redis ACL 계정 비밀번호 (api=전체, runner=큐 소비·자기 통계만). 인증 없는 Redis 접근은 없습니다.
REDIS_API_PASSWORD=odysseus-default-redis-api-password
REDIS_RUNNER_PASSWORD=odysseus-default-redis-runner-password

# pgdata 볼륨이 처음 만들어질 때 고정되는 값 — 이미 쓰던 볼륨이 있으면 바꾸지 마세요.
POSTGRES_PASSWORD=odysseus

# 최초 기동(빈 DB) 시 만들 관리자. 비밀번호를 비우면 무작위로 만들어 api 로그에 한 번 출력합니다:
#   docker compose logs api | grep bootstrap
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# 운영: 평문 HTTP 를 HTTPS 로 리다이렉트 + HSTS (TLS 는 Cloudflare/외부 프록시가 종단). 개발은 off.
EDGE_HTTPS_ONLY=off

# 로컬 개발 전용 — 고정 비밀번호의 데모 계정 3개를 만듭니다. 운영(production)에서는 기동을 거부합니다.
# ODYSSEUS_ENV=development
# SEED_DEMO_DATA=true
WEB_PORT=3100
API_PORT=8100
RUNNER_CONCURRENCY=2

# LLM env 폴백 (관리자 콘솔 > 설정에서 공급자 등록을 권장)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_EVAL_MODEL=gpt-4o-mini
